# ---------- backend (backend/.env or the host's environment) ----------
# PostgreSQL in production (Neon). SQLite works for local development.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
# Long random string. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ENVIRONMENT=production
COOKIE_SECURE=true
FRONTEND_URL=https://your-frontend.example
CORS_ORIGINS=https://your-frontend.example
# Payments. "test" is the only provider implemented. See docs/PAYMENTS.md before changing.
PAYMENT_PROVIDER=test
PAYMENT_TEST_MODE=true
RATE_LIMIT_ENABLED=true
# Number of proxies in front of the API that append to X-Forwarded-For (Render adds one). 0 for local work.
TRUSTED_PROXY_HOPS=1
# Demo accounts use a published password. Leave false unless this is a public demo with synthetic data only.
ALLOW_DEMO_SEED=false

# ---------- frontend (frontend/.env.local or the host's environment) ----------
# Where the Next.js server forwards /api requests.
BACKEND_URL=https://your-backend.example
# Optional. Leave empty to switch analytics off. The app works the same without them.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
